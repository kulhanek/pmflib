{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure PMFLib",
            "type": "shell",
            "command": "cmake",
            "args": [
                "."
            ],
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "echo": true,
                "panel": "new",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": [
                {
                    "owner": "cmake",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^CMake (Error|Warning|Deprecation Warning|Author Warning) at (.*):([0-9]+) \\(([^)]+)\\):$",
                            "severity": 1,
                            "file": 2,
                            "line": 3
                        },
                        {
                            "regexp": "^  (.*)$",
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "Build PMFLib",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Configure PMFLib"
            ],
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "echo": true,
                "panel": "new",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": [
                {
                    "owner": "myf",
                    "fileLocation": "absolute",
                    "severity": "error",
                    "pattern": [
                        {
                            "regexp": "^\\s*(.*\\.(?:f|F|for|FOR|f90|F90|f95|F95|f03|F03|f08|F08)):(\\d+):(\\d+):\\s*$",
                            "file": 1,
                            "line": 2,
                            "column": 3
                        },
                        {
                            "regexp": "^\\s*$"
                        },
                        {
                            "regexp": "^\\s*\\d+\\s*\\|.*$"
                        },
                        {
                            "regexp": "^\\s*\\|.*$"
                        },
                        {
                            "regexp": "^\\s*(?:Error|Fatal Error):\\s+(.*)$",
                            "message": 1
                        }
                    ]
                },
                {
                    "owner": "myf",
                    "fileLocation": "absolute",
                    "severity": "warning",
                    "pattern": [
                        {
                            "regexp": "^\\s*(.*\\.(?:f|F|for|FOR|f90|F90|f95|F95|f03|F03|f08|F08)):(\\d+):(\\d+):\\s*$",
                            "file": 1,
                            "line": 2,
                            "column": 3
                        },
                        {
                            "regexp": "^\\s*$"
                        },
                        {
                            "regexp": "^\\s*\\d+\\s*\\|.*$"
                        },
                        {
                            "regexp": "^\\s*\\|.*$"
                        },
                        {
                            "regexp": "^\\s*Warning:\\s+(.*)$",
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "Clean PMFLib",
            "type": "shell",
            "command": "${workspaceFolder}/CMakeClean.sh",
            "args": [
                "deep"
            ],
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "echo": true,
                "panel": "new",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": []
        }
    ]
}